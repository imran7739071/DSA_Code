{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run Java with IO",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "javac ${file} && if \"${relativeFileDirname}\"==\".\" (java -cp ${workspaceFolder} ${fileBasenameNoExtension}) else (java -cp ${workspaceFolder} ${relativeFileDirname}.${fileBasenameNoExtension}) < ${workspaceFolder}\\input.txt > ${workspaceFolder}\\output.txt && del ${fileDirname}\\*.class"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
